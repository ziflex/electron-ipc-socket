{
    "name": "electron-ipc-socket",
    "version": "4.0.0",
    "description": "Typed bidirectional MessagePort RPC sessions for Electron.",
    "type": "module",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./main": {
            "import": {
                "types": "./dist/esm/main.d.ts",
                "default": "./dist/esm/main.js"
            },
            "require": {
                "types": "./dist/cjs/main.d.ts",
                "default": "./dist/cjs/main.js"
            }
        },
        "./preload": {
            "import": {
                "types": "./dist/esm/preload.d.ts",
                "default": "./dist/esm/preload.js"
            },
            "require": {
                "types": "./dist/cjs/preload.d.ts",
                "default": "./dist/cjs/preload.js"
            }
        },
        "./renderer": {
            "import": {
                "types": "./dist/esm/renderer.d.ts",
                "default": "./dist/esm/renderer.js"
            },
            "require": {
                "types": "./dist/cjs/renderer.d.ts",
                "default": "./dist/cjs/renderer.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-cjs.mjs",
        "check": "npm run format && npm run typecheck && npm run lint && npm run test && npm run docs && npm run package:smoke",
        "clean": "node scripts/clean.mjs",
        "docs": "typedoc",
        "format": "prettier --check .",
        "format:write": "prettier --write .",
        "lint": "eslint .",
        "package:smoke": "npm run build && node scripts/package-smoke.mjs",
        "prepublishOnly": "npm run check",
        "test": "npm run test:unit && npm run test:types",
        "test:electron": "npm run build && tsc -p test/electron/tsconfig.json && node scripts/electron-fixture.mjs",
        "test:types": "tsc -p test/types/tsconfig.json",
        "test:unit": "node --import tsx --test test/unit/*.test.ts",
        "typecheck": "tsc -p tsconfig.json"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "peerDependencies": {
        "electron": ">=41 <44"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.13.3",
        "electron": "43.4.0",
        "esbuild": "0.28.2",
        "eslint": "10.8.1",
        "prettier": "3.9.6",
        "tsx": "4.23.12",
        "typedoc": "0.28.20",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ziflex/electron-ipc-socket.git"
    },
    "keywords": [
        "electron",
        "messageport",
        "ipc",
        "rpc",
        "typescript"
    ],
    "author": "Tim Voronov <ziflex@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ziflex/electron-ipc-socket/issues"
    },
    "homepage": "https://github.com/ziflex/electron-ipc-socket#readme"
}
